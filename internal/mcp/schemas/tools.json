{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "tools": [
    {
      "name": "ascp.operation.create",
      "title": "Create durable ASCP operation",
      "description": "Submit untrusted purchase and SellerQuote input to durable ASCP intake. Authenticated identity, deployment terms, and current finalized directory evidence are derived by the server. This never accepts approval or signer evidence and never signs or broadcasts.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request", "idempotencyKey"],
        "properties": {
          "request": {
            "type": "object",
            "additionalProperties": false,
            "required": ["taskId", "method", "url", "responseContract", "category", "sellerQuote", "sellerQuoteSignature"],
            "properties": {
              "taskId": {"type": "string", "minLength": 1, "maxLength": 1024},
              "method": {"type": "string", "minLength": 1, "maxLength": 16},
              "url": {"type": "string", "format": "uri", "maxLength": 8192},
              "requestBodyBase64": {"type": "string", "contentEncoding": "base64"},
              "headers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "value"],
                  "properties": {"name": {"type": "string"}, "value": {"type": "string"}}
                }
              },
              "responseContract": {
                "type": "object",
                "additionalProperties": false,
                "required": ["contentType", "schemaRef"],
                "properties": {"contentType": {"type": "string"}, "schemaRef": {"type": "string"}}
              },
              "category": {"type": "string", "minLength": 1, "maxLength": 1024},
              "reasonRef": {
                "type": "object",
                "additionalProperties": false,
                "required": ["blobRef", "contentHash"],
                "properties": {
                  "blobRef": {"type": "string", "minLength": 1, "maxLength": 4096},
                  "contentHash": {"type": "string", "pattern": "^0x[0-9a-f]{64}$"}
                }
              },
              "sellerQuote": {
                "type": "object",
                "additionalProperties": false,
                "required": ["purchaseSpecHash", "sellerId", "resourceId", "directoryVersion", "schemeVersion", "chainId", "asset", "amountBaseUnits", "payTo", "ackAuthority", "verificationSpecHash", "declaredWorkTime", "verificationBudgetSeconds", "quoteExpiresAt", "quoteNonce"],
                "properties": {
                  "purchaseSpecHash": {"type": "string", "pattern": "^0x[0-9a-f]{64}$"},
                  "sellerId": {"type": "string", "pattern": "^0x[0-9a-f]{64}$"},
                  "resourceId": {"type": "string", "pattern": "^0x[0-9a-f]{64}$"},
                  "directoryVersion": {"type": "integer", "minimum": 1},
                  "schemeVersion": {"type": "integer", "minimum": 1},
                  "chainId": {"type": "string", "pattern": "^[1-9][0-9]*$"},
                  "asset": {"type": "string", "pattern": "^0x[0-9a-f]{40}$"},
                  "amountBaseUnits": {"type": "string", "pattern": "^[1-9][0-9]*$"},
                  "payTo": {"type": "string", "pattern": "^0x[0-9a-f]{40}$"},
                  "ackAuthority": {"type": "string", "pattern": "^0x[0-9a-f]{40}$"},
                  "verificationSpecHash": {"type": "string", "pattern": "^0x[0-9a-f]{64}$"},
                  "declaredWorkTime": {"type": "integer", "minimum": 1},
                  "verificationBudgetSeconds": {"type": "integer", "minimum": 1},
                  "quoteExpiresAt": {"type": "integer", "minimum": 1},
                  "quoteNonce": {"type": "string", "pattern": "^0x[0-9a-f]{64}$"}
                }
              },
              "sellerQuoteSignature": {"type": "string", "pattern": "^0x[0-9a-f]{130}$"}
            }
          },
          "idempotencyKey": {"type": "string", "minLength": 1, "maxLength": 128}
        }
      }
    },
    {
      "name": "ascp.operation.get",
      "title": "Get durable ASCP operation",
      "description": "Read the redacted immutable operation owned by the authenticated agent. Cross-agent and cross-organization records are concealed.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operationId"],
        "properties": {"operationId": {"type": "string", "pattern": "^0x[0-9a-f]{64}$"}}
      }
    },
    {
      "name": "ascp.intent.create",
      "title": "Create spend intent",
      "description": "Legacy pre-ASCP compatibility tool. Submit one bounded PaymentIntent through the legacy policy and approval path. This does not create a durable ASCP operation and never signs or broadcasts a payment.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["intent", "idempotencyKey"],
        "properties": {
          "intent": {"type": "object", "description": "The canonical FlowOps PaymentIntent accepted by POST /v1/intents."},
          "idempotencyKey": {"type": "string", "minLength": 1, "maxLength": 128}
        }
      }
    },
    {
      "name": "ascp.intent.get",
      "title": "Get spend intent",
      "description": "Read the redacted lifecycle state of an intent owned by the authenticated agent or organization.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requestId"],
        "properties": {"requestId": {"type": "string", "minLength": 1, "maxLength": 128}}
      }
    },
    {
      "name": "ascp.approval.list",
      "title": "List pending approvals",
      "description": "List pending approvals for an authenticated human principal. Agent credentials cannot use this tool.",
      "inputSchema": {"type": "object", "additionalProperties": false}
    },
    {
      "name": "ascp.approval.get",
      "title": "Get approval",
      "description": "Read one organization-scoped approval record. Agent credentials cannot use this tool.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requestId"],
        "properties": {"requestId": {"type": "string", "minLength": 1, "maxLength": 128}}
      }
    },
    {
      "name": "ascp.approval.decide",
      "title": "Decide approval",
      "description": "Approve or reject an exact pending-approval snapshot. The control plane still requires the human role, fresh step-up authentication, request digest, and idempotency key.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requestId", "requestDigest", "action", "idempotencyKey"],
        "properties": {
          "requestId": {"type": "string", "minLength": 1, "maxLength": 128},
          "requestDigest": {"type": "string", "minLength": 1, "maxLength": 128},
          "action": {"type": "string", "enum": ["APPROVE", "REJECT"]},
          "note": {"type": "string", "maxLength": 2048},
          "idempotencyKey": {"type": "string", "minLength": 1, "maxLength": 128}
        }
      }
    }
  ]
}
