FLOWOPS_CONTROL_API_URL=https://control-api.example.com
FLOWOPS_SITES_PROJECT_ID=appgprj_replace_me
# Server-only exchange credential. Configure through Sites environment variables.
FLOWOPS_SITES_EXCHANGE_TOKEN=
# Optional only after the canonical evidence record verifies an experimental,
# unaudited FlowOpsProposalAnchor deployment on Base mainnet.
FLOWOPS_PROPOSAL_ANCHOR_ADDRESS=
# Local preview only. This is ignored unless the request host is loopback.
# It creates a non-production local identity; it never grants organization membership.
FLOWOPS_LOCAL_AUTH_ENABLED=false
