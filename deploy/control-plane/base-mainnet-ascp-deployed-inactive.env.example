# Public, non-secret bindings for the finalized zero-fund Base mainnet ASCP
# deployment. This file is intentionally NOT a complete production environment:
# startup must remain blocked until a signed release manifest, reviewed RPC
# admission, exact authority rules, secrets, and the settlement window are added
# through the production secret manager.
FLOWOPS_BASE_CHAIN_ID=8453
FLOWOPS_ESCROW_CONTRACT=0x214cbbb2190075ba43fa6518560d37c09720e0c4
FLOWOPS_ESCROW_ASSET=0x833589fcd6edb6e08f4c7c32d4f71b54bda02913
FLOWOPS_ASCP_DIRECTORY_CONTRACT=0x2bc89b98ada8335feab04d5b7b5af6a63eb95fd1
FLOWOPS_ASCP_AGENT_REGISTRY_CONTRACT=0x15332e8c8e230e8a1c05095196dac42ba8cc6906
FLOWOPS_ASCP_CALL_ESCROW_CONTRACT=0x214cbbb2190075ba43fa6518560d37c09720e0c4
FLOWOPS_ASCP_SPEND_MODULE_CONTRACT=0x942b83421c3ac4e1a04753e5e0208fd56cad649e
FLOWOPS_ASCP_GOVERNANCE_FROM_BLOCK=50557746

# Required before a Base mainnet runtime can start. Never commit their values:
# FLOWOPS_BASE_RPC_PROVIDERS_JSON
# FLOWOPS_BASE_RPC_ADMISSION_JSON
# FLOWOPS_BASE_MAINNET_RELEASE_MANIFEST_JSON
# FLOWOPS_BASE_MAINNET_RELEASE_PUBLIC_KEY_B64
# FLOWOPS_ASCP_CHAIN_AUTHORITY_RULES_JSON
# FLOWOPS_ESCROW_RELEASE_WINDOW_SECONDS
# FLOWOPS_METRICS_KEY_B64
