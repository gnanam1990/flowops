{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowops.dev/schemas/execution-commitment-v1.json",
  "title": "ASCP v4 ExecutionCommitment",
  "type": "object",
  "additionalProperties": false,
  "required": ["orgDomain", "operationId", "rail", "schemeVersion", "protection", "escrowContract", "purchaseSpecHash", "quoteHash", "verificationSpecHash", "declaredWorkTime", "verificationBudgetSeconds", "directoryVersion", "sellerId", "resourceId", "payTo", "ackAuthority", "amount", "chainId", "asset", "quoteExpiresAt", "acceptBy", "deliverBy", "settleBy"],
  "properties": {
    "orgDomain": {"$ref": "#/$defs/hash"},
    "operationId": {"$ref": "#/$defs/hash"},
    "rail": {"const": 1},
    "schemeVersion": {"const": 1},
    "protection": {"const": 1},
    "escrowContract": {"$ref": "#/$defs/address"},
    "purchaseSpecHash": {"$ref": "#/$defs/hash"},
    "quoteHash": {"$ref": "#/$defs/hash"},
    "verificationSpecHash": {"$ref": "#/$defs/hash"},
    "declaredWorkTime": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615},
    "verificationBudgetSeconds": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615},
    "directoryVersion": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615},
    "sellerId": {"$ref": "#/$defs/hash"},
    "resourceId": {"$ref": "#/$defs/hash"},
    "payTo": {"$ref": "#/$defs/address"},
    "ackAuthority": {"$ref": "#/$defs/address"},
    "amount": {"$ref": "#/$defs/uint256"},
    "chainId": {"$ref": "#/$defs/uint256"},
    "asset": {"$ref": "#/$defs/address"},
    "quoteExpiresAt": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615},
    "acceptBy": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615},
    "deliverBy": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615},
    "settleBy": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^0x[0-9a-f]{64}$"},
    "address": {"type": "string", "pattern": "^0x[0-9a-f]{40}$"},
    "uint256": {"type": "string", "pattern": "^[1-9][0-9]*$"}
  }
}
